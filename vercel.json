{
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|manifest\\.webmanifest|ngsw\\.json|ngsw-worker\\.js|favicon\\.ico|.*\\.css|.*\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(ngsw\\.json|ngsw-worker\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}